    {
      "name": "viajes_limpios",
      "sql": "CREATE VIEW viajes_limpios AS SELECT * FROM viajes WHERE ((\"year\"(pickup) = anio_archivo) AND (\"month\"(pickup) = mes_archivo) AND (duracion_min > 0) AND (duracion_min <= 360) AND (trip_distance > 0) AND (trip_distance <= 200) AND (fare_amount > 0) AND (total_amount > 0) AND (total_amount <= 1000) AND ((trip_distance / (duracion_min / 60)) <= 80));"
